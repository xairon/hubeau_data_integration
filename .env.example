# ==========================================
# HUB'EAU DATA PIPELINE - ENVIRONMENT VARIABLES
# ==========================================
# 
# USAGE:
#   1. Copier ce fichier: cp .env.example .env
#   2. Remplacer les valeurs par vos secrets
#   3. Ne jamais commit .env dans Git
#
# ==========================================

# ------------------------------------------
# DAGSTER - Orchestration
# ------------------------------------------
DAGSTER_PG_PASSWORD=your_strong_password_here

# ------------------------------------------
# DATABASES
# ------------------------------------------
# TimescaleDB + PostGIS
PG_PASSWORD=your_postgres_password_here

# Neo4j Graph Database
NEO4J_PASSWORD=your_neo4j_password_here

# ------------------------------------------
# MINIO - Object Storage (S3-compatible)
# ------------------------------------------
MINIO_USER=minioadmin
MINIO_PASS=minioadmin_change_in_production
MINIO_ENDPOINT=http://minio:9000
MINIO_BRONZE_BUCKET=bronze
MINIO_REGION=us-east-1

# ------------------------------------------
# PRODUCTION RECOMMENDATIONS
# ------------------------------------------
# - Use strong passwords (min 16 chars, mixed case, numbers, symbols)
# - Rotate passwords regularly (every 90 days)
# - Use secrets management (Vault, AWS Secrets Manager) in production
# - Enable TLS for all connections in production
# - Use read-only credentials where possible

# ------------------------------------------
# ARCHITECTURE NOTES
# ------------------------------------------
# Dagster uses 2 services:
#   - dagster_webserver: UI/GraphQL API (scalable horizontally)
#   - dagster_daemon: Background orchestration (single instance ONLY)
#
# All services share the same Docker network and can
# communicate using service names (e.g., minio:9000, postgres:5432)
#
# Data flow:
#   Hub'Eau APIs -> DLT Pipeline -> MinIO (Bronze)
#   MinIO -> TimescaleDB/PostGIS/Neo4j (Silver/Gold)

# ------------------------------------------
# HEALTH CHECK ENDPOINTS
# ------------------------------------------
# Dagster UI: http://localhost:8080
# MinIO Console: http://localhost:9001
# Neo4j Browser: http://localhost:7474
# PgAdmin: http://localhost:5050
