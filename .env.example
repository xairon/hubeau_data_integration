# ==========================================
# HUB'EAU DATA PIPELINE - VARIABLES D'ENVIRONNEMENT
# ==========================================
# Usage :
#   1. cp .env.example .env
#   2. Remplacer chaque valeur par votre secret
#   3. Ne jamais committer .env (déjà dans .gitignore)
# ==========================================

# ------------------------------------------
# PostgreSQL — données Hub'Eau
# ------------------------------------------
PG_PASSWORD=your_postgres_password_here
PG_DB=postgres
PG_USER=postgres
PG_HOST=postgres
PG_PORT=5432

# ------------------------------------------
# PostgreSQL — métadonnées Dagster
# ------------------------------------------
DAGSTER_PG_PASSWORD=your_dagster_password_here

# ------------------------------------------
# Superset
# ------------------------------------------
SUPERSET_SECRET_KEY=your_superset_secret_key_here
SUPERSET_ADMIN_PASSWORD=your_superset_admin_password_here

# ------------------------------------------
# Copernicus Climate Data Store (ERA5)
# ------------------------------------------
# Clé API : https://cds.climate.copernicus.eu/ (compte requis)
COPERNICUS_API_KEY=your_copernicus_api_key_here

# Délai de publication ERA5 (jours). Le job ERA5 ne charge que jusqu'à (aujourd'hui - N).
# Copernicus publie ERA5-Land avec quelques jours de latence.
# ERA5_AVAILABILITY_LAG_DAYS=5

# ------------------------------------------
# Activation orchestration Dagster
# ------------------------------------------
# Désactivés par défaut. Passer à true pour activer en production.
# DAGSTER_ENABLE_SCHEDULES=true
# DAGSTER_ENABLE_SENSORS=true

# ------------------------------------------
# Recommandations production
# ------------------------------------------
# - Mots de passe forts (>= 16 caractères, casse mixte, chiffres, symboles)
# - Rotation régulière (tous les 90 jours)
# - Gestion de secrets (Vault, AWS Secrets Manager) plutôt qu'un .env en clair
# - TLS sur toutes les connexions exposées

# ------------------------------------------
# Points d'accès
# ------------------------------------------
# Dagster     : http://localhost:49500
# Adminer     : http://localhost:49501
# PostgreSQL  : localhost:49502
# Superset    : http://localhost:49504
# dbt docs    : http://localhost:49505 (à lancer manuellement)
