# ==========================================
# Hub'Eau Data Pipeline — environment template
# ==========================================
#   1. cp .env.example .env
#   2. replace every placeholder with a real secret
#   3. never commit .env (already gitignored)
#
# Only the values marked REQUIRED have no default. Everything else is shown with the
# default the stack actually uses, so you can see it without reading docker-compose.yml.
# ==========================================

# ------------------------------------------
# PostgreSQL — the warehouse
# ------------------------------------------
PG_PASSWORD=your_postgres_password_here      # REQUIRED
PG_DB=postgres
PG_USER=postgres
PG_HOST=postgres
PG_PORT=5432

# ------------------------------------------
# PostgreSQL — Dagster metadata (separate database)
# ------------------------------------------
DAGSTER_PG_PASSWORD=your_dagster_password_here   # REQUIRED
# DAGSTER_PG_HOST=dagster_postgres
# DAGSTER_PG_PORT=5432
# DAGSTER_PG_DB=dagster
# DAGSTER_PG_USER=postgres

# ------------------------------------------
# Copernicus Climate Data Store (ERA5)
# ------------------------------------------
# REQUIRED for anything beyond Bronze. Without it dbt cannot build the Gold layer at all:
# the two daily fact tables depend on the ERA5 staging models.
# Getting the key, and the licence step everyone forgets: docs/API_KEYS.md
COPERNICUS_API_KEY=your_copernicus_api_key_here

# Publication lag in days. The ERA5 job only loads up to (today - N); Copernicus publishes
# ERA5-Land a few days late.
# NOTE: docker-compose.yml does not forward this to the worker — setting it here has no
# effect. See docs/CONFIGURATION.md.
# ERA5_AVAILABILITY_LAG_DAYS=5

# ------------------------------------------
# Dagster orchestration
# ------------------------------------------
# These default to TRUE in the Docker stack, not false: docker-compose.yml passes
# ${DAGSTER_ENABLE_SCHEDULES:-true}, overriding the `false` in the code. A fresh install
# therefore starts ingesting on its own overnight.
# Set them to false while you are exploring, and launch jobs yourself.
# DAGSTER_ENABLE_SCHEDULES=true
# DAGSTER_ENABLE_SENSORS=true

# ------------------------------------------
# Misc
# ------------------------------------------
# HUBEAU_SCHEMA=hubeau

# ------------------------------------------
# Production guidance
# ------------------------------------------
# - strong passwords (16+ characters), one per service
# - rotate every 90 days
# - prefer a secret manager over a plaintext .env
# - TLS on every exposed connection
#
# The compose file publishes its ports on 0.0.0.0, PostgreSQL included. On a shared host,
# prefix the mappings with 127.0.0.1: and put a reverse proxy or a VPN in front.

# ------------------------------------------
# Where things listen
# ------------------------------------------
# Dagster     http://localhost:49500
# Adminer     http://localhost:49501
# PostgreSQL  localhost:49502
# dbt docs    http://localhost:49505  (started manually)
