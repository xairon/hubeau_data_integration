# Dagster
DAGSTER_PG_PASSWORD=your_dagster_password

# TimescaleDB
PG_PASSWORD=your_postgres_password
# Optional overrides
# PG_HOST=timescaledb
# PG_PORT=5432
# PG_DATABASE=water
# PG_USER=postgres

# Neo4j
NEO4J_PASSWORD=your_neo4j_password
# Optional overrides
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j

# MinIO
MINIO_USER=admin
MINIO_PASS=your_minio_password
MINIO_REGION=us-east-1
MINIO_BRONZE_BUCKET=bronze
MINIO_ENDPOINT=http://minio:9000
# AWS_ACCESS_KEY_ID mirror MINIO_USER for dlt access
# AWS_SECRET_ACCESS_KEY mirror MINIO_PASS for dlt access
