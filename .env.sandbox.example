# Hub'Eau Pipeline — variables d'environnement SANDBOX (POC)
# ----------------------------------------------------------------------------
# NE PAS committer de vraies valeurs. Sur le sandbox, renseigne ces variables
# directement dans l'UI Portainer (Stack → Environment variables), PAS via un
# fichier .env sur le serveur.
#
# Génère des secrets solides :  openssl rand -hex 32

# --- Mots de passe base de données (REQUIS) ---------------------------------
DAGSTER_PG_PASSWORD=
PG_PASSWORD=
# Le worker se connecte à PostGIS sur la même instance Postgres : reprends PG_PASSWORD
POSTGIS_PASSWORD=

# --- Identité base (optionnel, valeurs par défaut dans le compose) ----------
PG_DB=postgres
PG_USER=postgres
HUBEAU_SCHEMA=hubeau

# --- API externe ERA5 / Copernicus CDS (REQUIS pour le bootstrap ERA5) ------
# Clé personnelle CDS : https://cds.climate.copernicus.eu/ (profil → API key)
COPERNICUS_API_KEY=

# --- Superset (BI) ----------------------------------------------------------
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_ADMIN_EMAIL=admin@hubeau.com

# --- Bootstrap POC : restreindre la portée (sinon = TOUT 1990→présent) ------
# Allowlist de tokens "job_name:partition_key" séparés par des virgules.
# Tokens disponibles :
#   reference_data:all
#   stations:all
#   chroniques:piezometry:<année>     (ex. chroniques:piezometry:2024)
#   chroniques:hydrometry:<année>
#   era5:<année>-<année>              (chunks 1 an, ex. era5:2024-2024)
# Exemple "POC 2 années récentes" :
# BOOTSTRAP_PARTITIONS=reference_data:all,stations:all,chroniques:piezometry:2024,chroniques:piezometry:2025,chroniques:hydrometry:2024,chroniques:hydrometry:2025,era5:2024-2024,era5:2025-2025
BOOTSTRAP_PARTITIONS=
# Continuer malgré l'échec d'une partition (utile en POC, API parfois 503)
BOOTSTRAP_CONTINUE_ON_ERROR=true

# --- Orchestration (laisser true en POC pour valider toute la chaîne) -------
DAGSTER_ENABLE_SCHEDULES=true
DAGSTER_ENABLE_SENSORS=true
