# ═══════════════════════════════════════════════════════════
# Hub'Eau Pipeline - Environment Variables Template
# ═══════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in the values
# IMPORTANT: .env is gitignored - never commit credentials!
#
# For GitLab CI/CD: Add these as CI/CD variables in:
# Settings > CI/CD > Variables
# ═══════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────
# Dagster Orchestrator Database
# ───────────────────────────────────────────────────────────
# PostgreSQL database used by Dagster for orchestration metadata
# (runs, logs, schedules, sensors, etc.)

DAGSTER_PG_HOST=dagster_postgres
DAGSTER_PG_PORT=5432
DAGSTER_PG_DB=dagster
DAGSTER_PG_USER=postgres
DAGSTER_PG_PASSWORD=your_dagster_password_here


# ───────────────────────────────────────────────────────────
# Data Storage - PostgreSQL/PostGIS
# ───────────────────────────────────────────────────────────
# PostgreSQL (standard relational) and PostGIS (geospatial) databases
# Used for Silver/Gold layers
#
# Local development:
#   - Postgres (localhost:5432) - Standard PostgreSQL
#   - PostGIS (localhost:5433) - PostgreSQL with geospatial extensions
#
# Production: You can point to external managed databases (AWS RDS, etc.)

# Standard Postgres
PG_HOST=postgres
PG_PORT=5432
PG_DB=postgres
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here

# PostGIS
POSTGIS_HOST=postgis
POSTGIS_PORT=5432
POSTGIS_DB=postgres
POSTGIS_USER=postgres
POSTGIS_PASSWORD=your_postgis_password_here


# ───────────────────────────────────────────────────────────
# Object Storage - MinIO (S3-compatible)
# ───────────────────────────────────────────────────────────
# Bronze layer data lake storage
# MinIO is S3-compatible, so we use AWS-style credentials
#
# Examples:
#   Local MinIO:     http://minio:9000 (Docker) or http://localhost:9000
#   AWS S3:          https://s3.amazonaws.com (set region accordingly)
#   Scaleway:        https://s3.fr-par.scw.cloud
#   DigitalOcean:    https://fra1.digitaloceanspaces.com

MINIO_ENDPOINT=http://minio:9000
MINIO_USER=admin
MINIO_PASS=your_minio_password_here
MINIO_REGION=us-east-1
MINIO_BRONZE_BUCKET=bronze

# External S3 endpoint (if using AWS S3, Scaleway, etc. instead of local MinIO)
# Uncomment and set if you want to use external S3-compatible storage
# S3_ENDPOINT_URL=https://s3.eu-west-3.amazonaws.com
# S3_REGION=eu-west-3


# ───────────────────────────────────────────────────────────
# Monitoring & Observability
# ───────────────────────────────────────────────────────────

# Grafana admin password (for dashboards)
GRAFANA_PASSWORD=admin

# Prometheus (no auth by default)
PROMETHEUS_PORT=9090


# ───────────────────────────────────────────────────────────
# Optional: External Services
# ───────────────────────────────────────────────────────────
# Uncomment if you want to use external managed services instead of Docker

# External Redis (for caching)
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# External TimescaleDB (future - for > 100M rows time-series)
# TIMESCALE_HOST=timescaledb.example.com
# TIMESCALE_PORT=5432
# TIMESCALE_DB=water_timeseries
# TIMESCALE_USER=hubeau
# TIMESCALE_PASSWORD=your_timescale_password


# ═══════════════════════════════════════════════════════════
# NOTES ON CONFIGURATION
# ═══════════════════════════════════════════════════════════
#
# Environment-Specific Configurations:
# -------------------------------------
#
# LOCAL DEVELOPMENT:
#   - Use Docker service names (minio, postgres, postgis)
#   - Ports are internal to Docker network
#   - Access from host: localhost:5432, localhost:9000, etc.
#
# PRODUCTION (Docker Compose on VPS):
#   - Use Docker service names (minio, postgres, postgis)
#   - Same as local but with production passwords
#
# PRODUCTION (External services):
#   - Set actual hostnames (e.g., postgres.example.com)
#   - Set actual ports (e.g., 5432 for external Postgres)
#   - Update docker-compose to remove unused services
#
# HYBRID (Some local, some external):
#   - Mix and match! e.g., local Postgres but external MinIO (S3)
#   - Change MINIO_ENDPOINT to https://s3.amazonaws.com
#   - Change MINIO_USER/PASS to AWS Access Key/Secret Key
#
# AWS Variables:
# --------------
# You'll see AWS_* variables in docker-compose files. These are
# NOT for real AWS - they're for MinIO S3 compatibility!
#
# MinIO is S3-compatible storage, so libraries like boto3 and s3fs
# expect AWS-style credentials. We use:
#   AWS_ACCESS_KEY_ID = MINIO_USER
#   AWS_SECRET_ACCESS_KEY = MINIO_PASS
#   AWS_ENDPOINT_URL = MINIO_ENDPOINT
#
# If you use real AWS S3, just set MINIO_* variables to your AWS credentials!
#
# DLT Variables:
# --------------
# DLT (Data Load Tool) has its own credential format:
#   DESTINATION__FILESYSTEM__CREDENTIALS__AWS_ACCESS_KEY_ID
#   DESTINATION__FILESYSTEM__CREDENTIALS__AWS_SECRET_ACCESS_KEY
#   DESTINATION__FILESYSTEM__CREDENTIALS__ENDPOINT_URL
#
# These are automatically set from MINIO_* variables in docker-compose.
# You only need to set the MINIO_* variables above.
#
# Database Stack:
# ---------------
# Current: PostgreSQL + PostGIS only
# Future: TimescaleDB for time-series optimization (> 100M rows)
#
# ═══════════════════════════════════════════════════════════
