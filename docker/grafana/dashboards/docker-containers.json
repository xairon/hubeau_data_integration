{
  "annotations": { "list": [] },
  "description": "Docker rootless: les containers sont identifiés par hash court (12 chars). Lancer 'docker ps' pour voir la correspondance hash → nom.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Container ID → Name (run: docker ps --format 'table {{.ID}}\\t{{.Names}}')",
      "type": "text",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "**Docker rootless** : cAdvisor ne peut pas résoudre les noms. Les légendes montrent les 12 premiers caractères du hash Docker.\n\nPour voir la correspondance : `docker ps --format 'table {{.ID}}\\t{{.Names}}'`"
      }
    },
    {
      "title": "CPU Usage per Container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "fillOpacity": 20 }
        }
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{container_id!=\"\"}[1m])",
          "legendFormat": "{{container_id}}"
        }
      ]
    },
    {
      "title": "Memory Usage per Container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 20 }
        }
      },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{container_id!=\"\"}",
          "legendFormat": "{{container_id}}"
        }
      ]
    },
    {
      "title": "Memory Usage vs Limit (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{container_id!=\"\"} / container_spec_memory_limit_bytes{container_id!=\"\"} > 0",
          "legendFormat": "{{container_id}}"
        }
      ]
    },
    {
      "title": "Network I/O per Container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "rate(container_network_receive_bytes_total{container_id!=\"\"}[1m])",
          "legendFormat": "{{container_id}} (rx)"
        },
        {
          "expr": "rate(container_network_transmit_bytes_total{container_id!=\"\"}[1m])",
          "legendFormat": "{{container_id}} (tx)"
        }
      ]
    },
    {
      "title": "Disk I/O per Container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "rate(container_fs_reads_bytes_total{container_id!=\"\"}[1m])",
          "legendFormat": "{{container_id}} (read)"
        },
        {
          "expr": "rate(container_fs_writes_bytes_total{container_id!=\"\"}[1m])",
          "legendFormat": "{{container_id}} (write)"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Docker Containers - Hub'Eau",
  "uid": "hubeau-docker",
  "version": 2
}
