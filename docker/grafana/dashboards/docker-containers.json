{
  "annotations": { "list": [] },
  "description": "Docker rootless: containers identifiés par hash court. Lancer 'docker ps' pour la correspondance.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Correspondance Hash → Nom",
      "type": "text",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "**Docker rootless** : les légendes montrent les 12 premiers chars du hash Docker. Pour la correspondance :\n```\ndocker ps --format 'table {{.ID}}\\t{{.Names}}'\n```"
      }
    },
    {
      "title": "CPU Usage per Container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "fillOpacity": 20 }
        }
      },
      "targets": [
        {
          "expr": "label_replace(rate(container_cpu_usage_seconds_total{id=~\".*docker-.*\\\\.scope\"}[1m]), \"cid\", \"$1\", \"id\", \".*docker-([a-f0-9]{12}).*\")",
          "legendFormat": "{{cid}}"
        }
      ]
    },
    {
      "title": "Memory Usage per Container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 20 }
        }
      },
      "targets": [
        {
          "expr": "label_replace(container_memory_usage_bytes{id=~\".*docker-.*\\\\.scope\"}, \"cid\", \"$1\", \"id\", \".*docker-([a-f0-9]{12}).*\")",
          "legendFormat": "{{cid}}"
        }
      ]
    },
    {
      "title": "Memory Usage vs Limit (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "label_replace(container_memory_usage_bytes{id=~\".*docker-.*\\\\.scope\"} / container_spec_memory_limit_bytes{id=~\".*docker-.*\\\\.scope\"} > 0, \"cid\", \"$1\", \"id\", \".*docker-([a-f0-9]{12}).*\")",
          "legendFormat": "{{cid}}"
        }
      ]
    },
    {
      "title": "Network I/O per Container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "label_replace(rate(container_network_receive_bytes_total{id=~\".*docker-.*\\\\.scope\"}[1m]), \"cid\", \"$1\", \"id\", \".*docker-([a-f0-9]{12}).*\")",
          "legendFormat": "{{cid}} (rx)"
        },
        {
          "expr": "label_replace(rate(container_network_transmit_bytes_total{id=~\".*docker-.*\\\\.scope\"}[1m]), \"cid\", \"$1\", \"id\", \".*docker-([a-f0-9]{12}).*\")",
          "legendFormat": "{{cid}} (tx)"
        }
      ]
    },
    {
      "title": "Disk I/O per Container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "label_replace(rate(container_fs_reads_bytes_total{id=~\".*docker-.*\\\\.scope\"}[1m]), \"cid\", \"$1\", \"id\", \".*docker-([a-f0-9]{12}).*\")",
          "legendFormat": "{{cid}} (read)"
        },
        {
          "expr": "label_replace(rate(container_fs_writes_bytes_total{id=~\".*docker-.*\\\\.scope\"}[1m]), \"cid\", \"$1\", \"id\", \".*docker-([a-f0-9]{12}).*\")",
          "legendFormat": "{{cid}} (write)"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Docker Containers - Hub'Eau",
  "uid": "hubeau-docker",
  "version": 3
}
