{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "CPU Usage per Container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "fillOpacity": 20 }
        }
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\"brgm-.+\"}[1m])",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "title": "Memory Usage per Container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 20 }
        }
      },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name=~\"brgm-.+\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "title": "Memory Usage vs Limit",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name=~\"brgm-.+\"} / container_spec_memory_limit_bytes{name=~\"brgm-.+\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "title": "Network I/O per Container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "rate(container_network_receive_bytes_total{name=~\"brgm-.+\"}[1m])",
          "legendFormat": "{{name}} (rx)"
        },
        {
          "expr": "rate(container_network_transmit_bytes_total{name=~\"brgm-.+\"}[1m])",
          "legendFormat": "{{name}} (tx)"
        }
      ]
    },
    {
      "title": "Disk I/O per Container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "rate(container_fs_reads_bytes_total{name=~\"brgm-.+\"}[1m])",
          "legendFormat": "{{name}} (read)"
        },
        {
          "expr": "rate(container_fs_writes_bytes_total{name=~\"brgm-.+\"}[1m])",
          "legendFormat": "{{name}} (write)"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Docker Containers - Hub'Eau",
  "uid": "hubeau-docker",
  "version": 1
}
