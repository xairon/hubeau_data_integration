# DLT Worker - Image DÉVELOPPEMENT
# Installation EDITABLE pour hot reload du code source
# Responsabilités : Extraction, transformation, chargement
# Taille cible : ~2GB (avec GDAL/GEOS)
# Uses uv for ultra-fast dependency installation (100x faster than pip)

FROM python:3.11-slim

# Full system dependencies (géospatial, database clients)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        gdal-bin \
        libgdal-dev \
        libgeos-dev \
        libproj-dev \
        proj-bin \
        libspatialindex-dev \
        libpq-dev \
        curl \
        git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install uv (ultra-fast Python package installer)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Copy ONLY pyproject.toml for dependency installation
COPY pyproject.toml README.md /app/

# Create src directory structure (needed for editable install)
RUN mkdir -p /app/src/hubeau_pipeline

# Copy __init__.py to make it a valid package
COPY src/hubeau_pipeline/__init__.py /app/src/hubeau_pipeline/

# Install dependencies in EDITABLE mode (-e flag)
# This creates symlinks instead of copying files
# Changes in mounted /app/src will be immediately visible
RUN uv pip install --no-cache --system -e ".[worker]"

# Prevent Python from writing bytecode
ENV PYTHONDONTWRITEBYTECODE=1

# Copy static files (configs, scripts)
# Note: src/ will be mounted as volume for hot reload
COPY configs /app/configs
COPY scripts /app/scripts

# Make entrypoint executable
RUN chmod +x /app/scripts/worker_entrypoint.sh

ENV PYTHONPATH=/app/src:/app
ENV DAGSTER_HOME=/app/dagster_home

# Healthcheck (GRPC API)
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD python -c "import socket; s=socket.socket(); s.connect(('localhost', 4000)); s.close()" || exit 1

EXPOSE 4000 9091

# Start worker with metrics server
CMD ["/app/scripts/worker_entrypoint.sh"]
